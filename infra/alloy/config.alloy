discovery.docker "infinitune" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "infinitune_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("INFINITUNE_COMPOSE_PROJECT")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "infinitune" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.infinitune.targets
  labels        = { environment = "development", platform = "docker" }
  relabel_rules = discovery.relabel.infinitune_logs.rules
  forward_to    = [loki.process.recent_docker_logs.receiver]
}

loki.process "recent_docker_logs" {
  forward_to = [loki.write.local.receiver]

  stage.drop {
    older_than          = "55m"
    drop_counter_reason = "docker_backlog_outside_loki_window"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
