# PostgreSQl
POSTGRES_USER=pg_user
POSTGRES_PASSWORD=pg_password
POSTGRES_DB=pg_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_AUTH_DB=0

# Generate the private key with:
# openssl genpkey -algorithm Ed25519 -outform DER | base64 -w0
AUTH_JWT_PRIVATE_KEY_BASE64=

# Derive the public key from AUTH_JWT_PRIVATE_KEY_BASE64 with:
# printf '%s' "$AUTH_JWT_PRIVATE_KEY_BASE64" | base64 -d | openssl pkey -inform DER -pubout -outform DER | base64 -w0
AUTH_JWT_PUBLIC_KEY_BASE64=

# Auth Service
POSTGRES_AUTH_DB=auth_db
AUTH_PASSWORD_MEMORY_KIB=65536
AUTH_PASSWORD_ITERATIONS=3
AUTH_PASSWORD_PARALLELISM=4
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=lax
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_JWT_ISSUER=infinitune-auth
AUTH_JWT_AUDIENCE=infinitune-api
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_KEY_ID=auth-key-1

# User Service
POSTGRES_USER_DB=user_db
USER_ALLOWED_ORIGINS=http://localhost:5173
USER_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks

# Catalog Service
POSTGRES_CATALOG_DB=catalog_db
CATALOG_ALLOWED_ORIGINS=http://localhost:5173

# Local object storage
# Use development-only values with at least 3 characters for the user and 8 for the password.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_MEDIA_BUCKET=infinitune-media
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# Media Service
POSTGRES_MEDIA_DB=media_db
MEDIA_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
MEDIA_ALLOWED_ORIGINS=http://localhost:5173

# Playlist Service
POSTGRES_PLAYLIST_DB=playlist_db
PLAYLIST_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
PLAYLIST_ALLOWED_ORIGINS=http://localhost:5173
PLAYLIST_PERSONALIZATION_TTL=5m

# Content Service
POSTGRES_CONTENT_DB=content_db
CONTENT_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
CONTENT_ALLOWED_ORIGINS=http://localhost:5173

# Interaction Service
POSTGRES_INTERACTION_DB=interaction_db
INTERACTION_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
INTERACTION_ALLOWED_ORIGINS=http://localhost:5173
INTERACTION_GRPC_PORT=9090

# Comment Service
POSTGRES_COMMENT_DB=comment_db
COMMENT_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
COMMENT_ALLOWED_ORIGINS=http://localhost:5173

# History Service
POSTGRES_HISTORY_DB=history_db
HISTORY_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
HISTORY_ALLOWED_ORIGINS=http://localhost:5173
HISTORY_GRPC_PORT=9090
KAFKA_BROKERS=kafka:9092
KAFKA_HISTORY_TOPIC=history.listening.recorded.v1
KAFKA_RECOMMENDATION_GROUP=recommendation-history-v1
HISTORY_OUTBOX_POLL_INTERVAL=1s
HISTORY_OUTBOX_BATCH_SIZE=100

# Recommendation Service
POSTGRES_RECOMMENDATION_DB=recommendation_db
RECOMMENDATION_RUN_TTL=1h
RECOMMENDATION_GRPC_PORT=9090
RECOMMENDATION_AUTH_JWKS_URL=http://auth-service:8080/v1/auth/jwks
RECOMMENDATION_ALLOWED_ORIGINS=http://localhost:5173
