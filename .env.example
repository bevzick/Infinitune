# PostgreSQl
POSTGRES_USER=pg_user
POSTGRES_PASSWORD=pg_password
POSTGRES_DB=pg_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Auth Service
POSTGRES_AUTH_DB=auth_db
AUTH_PASSWORD_MEMORY_KIB=65536
AUTH_PASSWORD_ITERATIONS=3
AUTH_PASSWORD_PARALLELISM=4
AUTH_JWT_ISSUER=infinitune-auth
AUTH_JWT_AUDIENCE=infinitune-api
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_KEY_ID=auth-key-1

# Generate with: openssl genpkey -algorithm Ed25519 -outform DER | base64 -w0
AUTH_JWT_PRIVATE_KEY_BASE64=
